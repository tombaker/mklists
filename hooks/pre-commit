#!/bin/bash
set -e

echo "Running pytest"
pytest
echo "Running 'ctags -R --languages=python --exclude=.git --exclude=build --exclude=*.toml .'"
ctags -R --languages=python --exclude=.git --exclude=build --exclude=*.toml .
echo
echo '======================================================'
echo "Running pylint - configure with /Users/tbaker/github/tombaker/mklists/pylintrc (setup.cfg is for flake8)"
pylint src/mklists/
echo "End of pylint output"
