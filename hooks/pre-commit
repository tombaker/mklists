#!/bin/bash
set -e
set -o pipefail

echo "Running pytest"
uv run pytest
echo "Running 'ctags -R --languages=python --languages=-Rust --exclude=.git --exclude=build .'"
ctags -R --languages=python --languages=-Rust --exclude=.git --exclude=build .
echo
echo '======================================================'
echo "Running ruff check - configure in pyproject.toml"
uv run ruff check src/
echo "End of ruff output"
echo
echo "Running mypy"
uv run mypy src/
echo
# Pause only when a terminal is available (not, e.g., for Claude Code or CI)
if { true < /dev/tty; } 2>/dev/null; then
    read -r -p "Press Enter to open the commit message editor..." _ < /dev/tty
fi
